{
  "name": "@workspace/web-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node --import tsx/esm ./build.mjs",
    "build:app": "vite build --config app/vite.config.ts",
    "start": "node --enable-source-maps ./dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p app/tsconfig.json --noEmit",
    "test": "playwright test",
    "test:server": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@workspace/roles": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "wouter": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@workspace/leaflet-template": "workspace:*",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "~5.9.2",
    "tsx": "catalog:",
    "@playwright/test": "^1.62.1",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.16.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
